{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "viral-moments.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "moments"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "moments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "start",
          "end",
          "quote",
          "trigger",
          "profile",
          "context_needed",
          "payoff_candidate"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "quote": {
            "type": "string"
          },
          "trigger": {
            "type": "string"
          },
          "profile": {
            "type": "string"
          },
          "context_needed": {
            "type": "string"
          },
          "payoff_candidate": {
            "type": "string"
          },
          "visual_hook": {
            "type": "string"
          },
          "distortion_risk": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "estimated_scores": {
            "description": "Notas 0-10 que o Clip Hunter prevê para o corte montado; a conta do gate roda sobre elas (vch estimate).",
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            }
          },
          "publishability_estimate": {
            "description": "Gravado por vch estimate: a mesma conta do finalize sobre estimated_scores.",
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "estimate_below_gate": {
            "description": "Gravado por vch estimate: por que a nota não passaria no gate. Vazio = passaria.",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
