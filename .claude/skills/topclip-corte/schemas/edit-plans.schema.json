{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "edit-plans.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "plans"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "plans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "clip_id",
          "output_slug",
          "primary_context",
          "timeline",
          "captions",
          "audio"
        ],
        "properties": {
          "clip_id": {
            "type": "string"
          },
          "output_slug": {
            "type": "string"
          },
          "primary_context": {
            "type": "string"
          },
          "timeline": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "source_start",
                "source_end"
              ],
              "properties": {
                "source_start": {
                  "type": "number",
                  "minimum": 0
                },
                "source_end": {
                  "type": "number",
                  "minimum": 0
                },
                "crop_anchor_x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "zoom": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 2
                },
                "transition_in": {
                  "type": "string"
                },
                "preserve_pause": {
                  "type": "boolean"
                },
                "layout": {
                  "type": "string",
                  "enum": [
                    "cover",
                    "split"
                  ],
                  "description": "cover = crop unico 9:16 no locutor. split = quadro inteiro em cima + crop fechado embaixo (2-3 pessoas que nao cabem lado a lado)."
                },
                "framing_reason": {
                  "type": "string",
                  "description": "Por que este enquadramento neste subsegmento."
                },
                "clip_start": {
                  "type": "number",
                  "minimum": 0
                },
                "clip_end": {
                  "type": "number",
                  "minimum": 0
                },
                "synced_source": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2,
                  "description": "Faixa da fonte com que clip_start/clip_end foram calculados (scripts/tempos.py). Não edite: é o que permite recalcular quando a borda muda."
                },
                "edge_audio": {
                  "type": "object",
                  "description": "Medida de energia de cada borda feita por `./topclip corte bordas` (start/end: t, db, action, from)."
                }
              },
              "additionalProperties": true
            }
          },
          "captions": {
            "type": "object"
          },
          "audio": {
            "type": "object"
          },
          "cards": {
            "type": "array"
          },
          "optional_assets": {
            "type": "array"
          },
          "editor_notes": {
            "type": "string"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timing_sync": {
            "type": "object",
            "description": "Último recálculo automático dos tempos de clipe (bordas/autoframe)."
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
