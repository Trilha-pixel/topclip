{
  "cor": {
    "fundo":        {"$type": "color", "$value": "#0A0A0A", "$description": "tela cheia: preto"},
    "superficie":   {"$type": "color", "$value": "#171717", "$description": "cartões"},
    "texto":        {"$type": "color", "$value": "#FFFFFF"},
    "apoio":        {"$type": "color", "$value": "#D9D9D9"},
    "linha":        {"$type": "color", "$value": "#333333"},
    "acento":       {"$type": "color", "$value": "#FFE600", "$description": "o amarelo do destaque"},
    "sobre_acento": {"$type": "color", "$value": "#000000"},
    "alerta":       {"$type": "color", "$value": "#FF2E2E", "$description": "raro: o 'não'"}
  },
  "fonte": {
    "titulo": {"$type": "fontFamily", "$value": "Archivo Black", "$description": "tudo que grita"},
    "apoio":  {"$type": "fontFamily", "$value": "Archivo Black"},
    "numero": {"$type": "fontFamily", "$value": "Anton", "$description": "número condensado, gigante"},
    "rotulo": {"$type": "fontFamily", "$value": "Anton"}
  },
  "movimento": {"perfil": "energico"},
  "$extensions": {
