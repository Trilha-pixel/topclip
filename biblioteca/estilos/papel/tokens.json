    "fundo_claro": {"$type": "color", "$value": "#F4F0E8", "$description": "PAPER_LIGHT"},
    "texto":       {"$type": "color", "$value": "#373639", "$description": "INK"},
    "carvao":      {"$type": "color", "$value": "#29292B", "$description": "CHARCOAL"},
    "acento":      {"$type": "color", "$value": "#DBD653", "$description": "YELLOW: um acento por cena"},
    "apoio":       {"$type": "color", "$value": "#2E82F7", "$description": "BLUE: o outro acento"},
    "destaque":    {"$type": "color", "$value": "#C94850", "$description": "RED: raro por design"},
    "fita":        {"$type": "color", "$value": "#BFBBAE", "$description": "TAPE"}
  },
  "fonte": {
    "titulo":       {"$type": "fontFamily", "$value": "Archivo Narrow", "$description": "manchete condensada"},
    "mao":          {"$type": "fontFamily", "$value": "Permanent Marker", "$description": "etiqueta manual"},
    "mono":         {"$type": "fontFamily", "$value": "IBM Plex Mono", "$description": "legenda tecnica"},
    "numero":       {"$type": "fontFamily", "$value": "Fraunces", "$description": "numero editorial"},
    "apoio":        {"$type": "fontFamily", "$value": "Inter", "$description": "linha de apoio"},
