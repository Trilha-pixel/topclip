{
  "cor": {
    "fundo":        {"$type": "color", "$value": "#0B0B0B", "$description": "preto"},
    "superficie":   {"$type": "color", "$value": "#151413", "$description": "cartões"},
    "texto":        {"$type": "color", "$value": "#F2EDE4", "$description": "marfim"},
    "apoio":        {"$type": "color", "$value": "#B8AE9C"},
    "linha":        {"$type": "color", "$value": "#3A3328"},
    "acento":       {"$type": "color", "$value": "#C9A45C", "$description": "latão"},
    "sobre_acento": {"$type": "color", "$value": "#0B0B0B"}
  },
  "fonte": {
    "titulo":  {"$type": "fontFamily", "$value": "Fraunces", "$description": "serifa de display, fina"},
    "numero":  {"$type": "fontFamily", "$value": "Fraunces"},
    "apoio":   {"$type": "fontFamily", "$value": "Inter"},
    "rotulo":  {"$type": "fontFamily", "$value": "Inter", "$description": "caixa alta bem espaçada"},
    "italico": {"$type": "fontFamily", "$value": "Playfair Display Italic", "$description": "legenda"}
  },
  "movimento": {
    "perfil": "calmo",
    "ajustes": {"entrada_quadros": [16, 22], "saida_quadros": [10, 13], "stagger_quadros": 4,
                "deslocamento_entrada": 18}
  },
  "$extensions": {
    "topclip": {
      "traco": "limpo",
      "lapis": "luxo",
      "acabamento": {"grao": 0, "vinheta": 0, "aberracao": 0, "saturacao": 1.0},
      "boil": null,
      "tipografia": {
        "peso": {"titulo": 380, "numero": 300, "apoio": 400, "rotulo": 500},
        "tracking": {"rotulo": 0.3}
      }
    }
  }
}
